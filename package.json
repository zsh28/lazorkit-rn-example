{
  "name": "lazor-kit-examples",
  "version": "1.0.0",
  "private": true,
  "description": "Lazor Kit SDK examples and demos",
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@lazorkit/example-mobile",
    "mobile:dev": "npm run dev --workspace=@lazorkit/example-mobile",
    "mobile:ios": "npm run ios --workspace=@lazorkit/example-mobile",
    "mobile:android": "npm run android --workspace=@lazorkit/example-mobile",
    "mobile:web": "npm run web --workspace=@lazorkit/example-mobile",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "install:all": "npm install"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
